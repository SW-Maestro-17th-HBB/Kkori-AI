# 워커 환경변수 예시 (접두사 KKORI_WORKER_). 실제 .env 는 커밋 금지.
# 로컬은 아래 기본값으로 동작하므로 비워도 됨. dev/prod 는 값 주입 필요.

# 인프라 접속
KKORI_WORKER_REDIS_URL=redis://localhost:6379
KKORI_WORKER_POSTGRES_DSN=postgresql://kkori:kkori@localhost:5432/kkori

# S3 / MinIO (실서버는 빈값 → 실제 S3 + IAM Role)
KKORI_WORKER_S3_ENDPOINT_URL=http://localhost:9000
KKORI_WORKER_S3_REGION=ap-northeast-2
# 로컬 MinIO 자격 (docker-compose 기본값)
KKORI_WORKER_S3_ACCESS_KEY=kkori
KKORI_WORKER_S3_SECRET_KEY=kkori1234

# AI 제공자: fake(기본, 클라우드 불필요) | bedrock(실제 호출 — 아래 AWS 자격 필요)
KKORI_WORKER_AI_PROVIDER=fake
# fake 제공자 인위 지연(초) — 동기 디스패치 부하 실험용(PRD §11.3), 0 = 지연 없음(기본).
# 분석 1건당 총 지연 ≈ 이 값. Spring read timeout(120s)보다 작게 유지.
KKORI_WORKER_FAKE_DELAY_SECONDS=0
# 동기 HTTP 경로 전용 커넥션 풀 최대 연결 수(PRD §11.4) — 동시 처리·DB 연결 상한이자 처리량 노브.
# to_thread 스레드풀(min(32, cpu+4)) 이하로 잡아야 노브가 실제로 동작한다.
KKORI_WORKER_SYNC_POOL_MAX_SIZE=10
# 풀 대기 타임아웃(초) — 연결이 전부 대출 중일 때 이만큼 기다리다 503. 대기+처리 < 120s(Spring) 유지.
KKORI_WORKER_SYNC_POOL_WAIT_TIMEOUT_S=60

# AWS Bedrock — 조직 SCP 가 us-east-1 만 허용 (2026-07-21 실 호출 탐침으로 확정)
KKORI_WORKER_BEDROCK_REGION=us-east-1
KKORI_WORKER_STRUCTURING_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
KKORI_WORKER_EMBEDDING_MODEL_ID=cohere.embed-v4:0

# AWS 자격증명 (Bedrock 용, boto3 표준 환경변수 — IAM 액세스 키 발급 후 채우기)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 소비자 / 재량 파라미터
KKORI_WORKER_CONSUMER_GROUP=kkori-worker
KKORI_WORKER_REPORT_CONSUMER_GROUP=kkori-report-worker
KKORI_WORKER_DELIVERY_COUNT_THRESHOLD=3
KKORI_WORKER_CLAIM_MIN_IDLE_MS=300000
# 회수 구독자 폴링 간격(ms) — 최악 복구 지연 = CLAIM_MIN_IDLE_MS + 이 값
KKORI_WORKER_RECLAIM_POLL_INTERVAL_MS=5000
