# 워커 환경변수 예시 (접두사 KKORI_WORKER_). 실제 .env 는 커밋 금지.
# 로컬은 아래 기본값으로 동작하므로 비워도 됨. dev/prod 는 값 주입 필요.

# 인프라 접속
KKORI_WORKER_REDIS_URL=redis://localhost:6379
KKORI_WORKER_POSTGRES_DSN=postgresql://kkori:kkori@localhost:5432/kkori

# S3 / MinIO (실서버는 빈값 → 실제 S3 + IAM Role)
KKORI_WORKER_S3_ENDPOINT_URL=http://localhost:9000
KKORI_WORKER_S3_REGION=ap-northeast-2

# AWS Bedrock (모델 ID 는 콘솔 기준으로 확인·교체)
KKORI_WORKER_BEDROCK_REGION=us-east-1
KKORI_WORKER_STRUCTURING_MODEL_ID=anthropic.claude-haiku-4-5
KKORI_WORKER_EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3

# 소비자 / 재량 파라미터
KKORI_WORKER_CONSUMER_GROUP=kkori-worker
KKORI_WORKER_DELIVERY_COUNT_THRESHOLD=3
KKORI_WORKER_CLAIM_MIN_IDLE_MS=300000
