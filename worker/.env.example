# 워커 환경변수 예시 (접두사 KKORI_WORKER_). 실제 .env 는 커밋 금지.
# 로컬은 아래 기본값으로 동작하므로 비워도 됨. dev/prod 는 값 주입 필요.

# 인프라 접속
KKORI_WORKER_REDIS_URL=redis://localhost:6379
KKORI_WORKER_POSTGRES_DSN=postgresql://kkori:kkori@localhost:5432/kkori

# S3 / MinIO (실서버는 빈값 → 실제 S3 + IAM Role)
KKORI_WORKER_S3_ENDPOINT_URL=http://localhost:9000
KKORI_WORKER_S3_REGION=ap-northeast-2
# 로컬 MinIO 자격 (docker-compose 기본값)
KKORI_WORKER_S3_ACCESS_KEY=kkori
KKORI_WORKER_S3_SECRET_KEY=kkori1234

# AI 제공자: fake(기본, 클라우드 불필요) | bedrock(실제 호출 — 아래 AWS 자격 필요)
KKORI_WORKER_AI_PROVIDER=fake

# AWS Bedrock (서울 리전, 2026-07-21 콘솔 확인)
KKORI_WORKER_BEDROCK_REGION=ap-northeast-2
KKORI_WORKER_STRUCTURING_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
KKORI_WORKER_EMBEDDING_MODEL_ID=cohere.embed-v4:0

# AWS 자격증명 (Bedrock 용, boto3 표준 환경변수 — IAM 액세스 키 발급 후 채우기)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 소비자 / 재량 파라미터
KKORI_WORKER_CONSUMER_GROUP=kkori-worker
KKORI_WORKER_DELIVERY_COUNT_THRESHOLD=3
KKORI_WORKER_CLAIM_MIN_IDLE_MS=300000
