# LiveKit Cloud 프로젝트 설정값 (lk cloud auth 또는 콘솔에서 확인)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 대화 로그 Redis write-through 사본 (선택 — 미설정 시 메모리 단독으로 동작)
# 로컬: redis://localhost:6379
KKORI_AGENT_REDIS_URL=

# transcript DB 저장 (세션 종료 flush — sessionId 있는 운영 잡은 미설정 시 시작 거부)
# 로컬: postgresql://postgres:postgres@localhost:5432/postgres
KKORI_AGENT_DATABASE_URL=
