# LiveKit SFU 접속값 — Cloud면 프로젝트 설정값, self-hosted면 해당 서버 주소·키
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Self-hosted SFU 전용 — VAD·TurnDetector·interruption(inference.*)은 LiveKit Cloud
# Inference 게이트웨이 기능이라, SFU를 자체 운영하면 아래에 Cloud 프로젝트 키를 별도로
# 넣어야 한다 (미설정 시 위 LIVEKIT_API_KEY로 폴백 → self-hosted 키는 게이트웨이 인증 실패).
# STT(Deepgram)·TTS(ElevenLabs)는 직결이라 무관. 2026-08-11 EC2 실측 검증.
# LIVEKIT_INFERENCE_API_KEY=
# LIVEKIT_INFERENCE_API_SECRET=

# AWS Bedrock LLM 자격증명 (boto3 기본 체인 — IAM 사용자 액세스 키)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Deepgram STT 자격증명 (콘솔 → API Keys에서 발급)
DEEPGRAM_API_KEY=

# ElevenLabs TTS 자격증명 (대시보드 → API Keys — Text to Speech 권한만 필요)
ELEVEN_API_KEY=

# LLM 프로바이더 토글 (선택 — 미설정 시 bedrock. 전환기 비교·AWS 키 없는 환경용: inference)
# KKORI_LLM_PROVIDER=inference

# 대화 로그 Redis write-through 사본 (선택 — 미설정 시 메모리 단독으로 동작)
# 로컬: redis://localhost:6379
KKORI_AGENT_REDIS_URL=

# transcript DB 저장 (세션 종료 flush — sessionId 있는 운영 잡은 미설정 시 시작 거부)
# 로컬: postgresql://postgres:postgres@localhost:5432/postgres
KKORI_AGENT_DATABASE_URL=
